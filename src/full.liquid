{% if error != blank and games.size == 0 %}
  <div class="layout layout--col layout--center">
    <span class="title">College Football</span>
    <span class="label">Could not load scores</span>
    <span class="description">{{ error }}</span>
  </div>
  <div class="title_bar">
    <span class="title">College Football</span>
  </div>
{% elsif games.size == 0 %}
  <div class="layout layout--col layout--center">
    <span class="title">No games this week</span>
  </div>
  <div class="title_bar">
    <span class="title">College Football</span>
  </div>
{% else %}
  {% assign featured = games.first %}
  <div class="layout layout--col">
    <div class="flex flex--row flex--center-x flex--center-y">
      <div class="item">
        {% if featured.away.logo != blank %}
          <img class="image" src="{{ featured.away.logo }}" alt="{{ featured.away.name }}" width="72">
        {% endif %}
        <div class="label label--large">
          {% if featured.away.rank %}#{{ featured.away.rank }} {% endif %}{{ featured.away.name }}
        </div>
        <div class="description">{{ featured.away.record }}</div>
      </div>

      <div class="item text--center">
        {% if featured.state == "pre" %}
          <span class="value value--small">{{ featured.detail }}</span>
        {% else %}
          <span class="value value--xlarge">{{ featured.away.score }}-{{ featured.home.score }}</span>
          <div class="label">{{ featured.detail }}</div>
        {% endif %}
        {% if featured.broadcast != blank %}
          <div class="description">{{ featured.broadcast }}</div>
        {% endif %}
      </div>

      <div class="item">
        {% if featured.home.logo != blank %}
          <img class="image" src="{{ featured.home.logo }}" alt="{{ featured.home.name }}" width="72">
        {% endif %}
        <div class="label label--large">
          {% if featured.home.rank %}#{{ featured.home.rank }} {% endif %}{{ featured.home.name }}
        </div>
        <div class="description">{{ featured.home.record }}</div>
      </div>
    </div>

    {% assign rest = games | slice: 1, 10 %}
    <div class="grid grid--cols-2">
      {% for game in rest %}
        <div class="grid grid--cols-4">
          <span class="label">
            {% if game.away.rank %}#{{ game.away.rank }} {% endif %}{{ game.away.abbr }}
          </span>
          <span class="description">@</span>
          <span class="label">
            {% if game.home.rank %}#{{ game.home.rank }} {% endif %}{{ game.home.abbr }}
          </span>
          <span class="label label--small">
            {% if game.state == "pre" %}
              {{ game.detail }}
            {% else %}
              {{ game.away.score }}-{{ game.home.score }}
            {% endif %}
          </span>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="title_bar">
    <span class="title">College Football</span>
    <span class="instance">Week {{ week_number }}</span>
  </div>
{% endif %}
